# GlucoCare - environment variables (TEMPLATE)
# =============================================================
# DO NOT PUT REAL KEYS IN THIS FILE - it is committed to git.
# Copy it to a new file named ".env" (git-ignored) and fill in values there:
#     cp .env.example .env
#
# The app works with NONE of these set: history is then saved on this device
# only, and the AI explanation shows "not connected".
#
# TWO KINDS OF VARIABLE:
#   VITE_...    -> bundled into the website, visible to anyone. Only public values.
#   everything else (API keys) -> SERVER ONLY (server/ai-proxy.mjs), never sent to the browser.
# NEVER add a "VITE_" prefix to an API key - that would publish it.


# ==============================================================
# Supabase - cloud health history (optional)
# ==============================================================
# Dashboard -> Project Settings -> API. Use the PUBLIC "anon" / "publishable"
# key. NEVER the service_role / secret key.
# Also: run supabase/migrations/0001 and 0002 in the SQL editor, and enable
# Authentication -> Sign In / Providers -> "Allow anonymous sign-ins".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ==============================================================
# AI-assisted explanation (optional)
# ==============================================================
# Start the website + AI server together with:  npm run dev:all
# The browser calls this URL (the local AI server):
VITE_AI_FUNCTION_URL=http://localhost:8787/api/explain-results
# For a DEPLOYED site use the Supabase Edge Function instead (keys stored as
# function secrets, see supabase/functions/explain-results/index.ts):
# VITE_AI_FUNCTION_URL=https://<project-ref>.functions.supabase.co/explain-results

# Choose ONE provider. Gemini and Groq have free tiers (no card).
# If AI_PROVIDER is blank, the server picks one based on which key is present.
AI_PROVIDER=gemini

# --- Google Gemini (free tier): https://aistudio.google.com/apikey -------
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash; if that model is busy or retired the
# server tries the fallbacks (comma-separated) in order.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest

# --- Groq (free tier): https://console.groq.com/keys ---------------------
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (runs on your PC, no key): https://ollama.com -----------------
# AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# --- Anthropic Claude (paid): https://console.anthropic.com ---------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- AI server protection (optional; defaults shown) ---------------------
# Browser origins allowed to call the AI server (comma-separated).
# AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Requests per client per 10 minutes.
# AI_RATE_LIMIT=20
# How long to wait for the AI provider (milliseconds).
# AI_PROVIDER_TIMEOUT_MS=25000
# AI_PROXY_PORT=8787
