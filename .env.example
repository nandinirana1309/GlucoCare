# GlucoCare - environment variables
# =============================================================
# Copy this file to ".env" and fill in what you need. The app works with NONE
# of these set (localStorage only, AI shows "not connected").
#
# TWO KINDS OF VARIABLE:
#   VITE_...    -> safe for the browser, bundled into the site
#   everything else (API keys) -> SERVER ONLY, never sent to the browser
#
# NEVER add a "VITE_" prefix to an API key - that would leak it.


# ==============================================================
# Stage 8: AI-assisted explanation
# ==============================================================
# The frontend calls this URL. For local development with "npm run server":
VITE_AI_FUNCTION_URL=http://localhost:8787/api/explain-results

# Choose ONE provider below. The first three have a FREE tier (no card).
# If you leave AI_PROVIDER blank, the server auto-picks based on the key present.
# AI_PROVIDER=gemini

# --- Option 1: Google Gemini (free tier, easiest) -------------
# Get a key (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Option 2: Groq (free tier, very fast) --------------------
# Get a key (no card): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Option 3: Ollama (100% free, runs on your PC, no key) ----
# Install https://ollama.com  then:  ollama pull llama3.2
# Set AI_PROVIDER=ollama above. No key needed.
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434

# --- Option 4: Anthropic Claude (paid) -----------------------
# https://console.anthropic.com  -> Settings -> API Keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# For a DEPLOYED site, use a Supabase Edge Function instead of the local
# server and point the frontend at it:
# VITE_AI_FUNCTION_URL=https://<project-ref>.functions.supabase.co/explain-results


# ==============================================================
# Stage 7: Supabase database backup (optional, independent of AI)
# ==============================================================
# From the Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
